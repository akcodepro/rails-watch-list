<div class="container">
  <h1>New Bookmark</h1>
  <div class="container">
    <%= simple_form_for [@list, @bookmark] do |f| %>
      <%= f.input :comment, placeholder: 'Add details' %>
      <%= f.association :movie, collection: Movie.all %>
      <%= f.button :submit %>
    <% end %>
  </div>
  <%= link_to "Back to all lists", lists_path %>
</div>
