<div class="container">
  <h1>Lists</h1>
  <div class="container">
    <ul>
      <% @lists.each do |l| %>
        <li>
          <%= link_to l.name, list_path(l) %>
          <%= button_to "X", list_path(l), method: :delete %>
        </li>
      <% end %>
    </ul>
  </div>
  <%= link_to "Create a list", new_list_path %>
</div>
