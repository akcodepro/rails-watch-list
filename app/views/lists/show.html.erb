<div class="container">
  <h1><%= @list.name %></h1>
  <div class="container">
    <% @list.movies.each do |m| %>
      <h2><%= m.title %></h2>
      <% bookmark = Bookmark.find_by(list: @list, movie: m) %>
      <%= bookmark.comment %>
      <%= button_to "X", bookmark_path(bookmark), method: :delete %>
    <% end %>
  </div>
  <%= link_to "Back to all lists", lists_path %>
  <%= link_to "Add a bookmark", new_list_bookmark_path(@list) %>
</div>
